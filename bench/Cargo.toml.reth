[package]
name = "bench"
version = "0.1.0"
edition = "2021"
publish = false

[dependencies]
qmdb = { workspace = true, default-features = true }
byteorder = { workspace = true }
threadpool = { workspace = true }
rayon = { workspace = true }
parking_lot = { workspace = true, features = ["arc_lock"] }
memory-stats = { workspace = true }
clap = { workspace = true, features = ["derive"] }
serde = { workspace = true, features = ["derive"] }
chrono = { workspace = true, features = ["serde"] }
serde_json = { workspace = true, features = ["std"] }
hex = { workspace = true }
log = { workspace = true }
once_cell = { workspace = true }
qmdb-common = { workspace = true }
crossbeam = { workspace = true }
libc = "0.2"
lazy_static = "1.4.0"
sha2 = "0.10"
fxhash = "0.2"
bincode = "1.3"

reth-libmdbx = { workspace = true }
nomt = { path = "../../nomt/nomt", optional = true }
nomt-core = { path = "../../nomt/core", optional = true }

# LVMT deps disabled in Reth mode: cfx-kvdb-rocksdb (zstd-sys ^1) and
# reth-primitives (zstd-sys ^2) both declare links="zstd" and conflict at
# Cargo resolution time even as optional deps. Use switch_backend.sh to flip.
# lvmt-db = { path = "../../lvmt/asb-authdb/lvmt-db", optional = true, features = ["large_lvmt"] }
# kvdb = { version = "0.4", optional = true }
# cfx-kvdb-rocksdb = { path = "../../lvmt/asb-backend/cfx-kvdb-rocksdb", optional = true }

# Reth deps active in Reth mode
reth-db = { path = "../../reth/crates/storage/db", optional = true, features = ["test-utils"] }
reth-db-api = { path = "../../reth/crates/storage/db-api", optional = true, features = ["test-utils"] }
reth-trie = { path = "../../reth/crates/trie/trie", optional = true }
reth-trie-common = { path = "../../reth/crates/trie/common", optional = true }
reth-trie-db = { path = "../../reth/crates/trie/db", optional = true }
reth-trie-parallel = { path = "../../reth/crates/trie/parallel", optional = true }
reth-provider = { path = "../../reth/crates/storage/provider", optional = true, features = ["test-utils"] }
reth-primitives = { path = "../../reth/crates/primitives", optional = true }
reth-node-types = { path = "../../reth/crates/node/types", optional = true }
alloy-primitives = { version = "0.8.26", optional = true }

eth-replay-kv = {path = "../../eth-replay-kv/"}
tokio.workspace = true
rand = { version = "0.10.0", features = ["std", "std_rng"] }

[target.'cfg(target_os = "linux")'.dependencies]
procfs = { version = "0.17", features = ["serde1", "chrono"] }
tikv-jemallocator = { workspace = true }

[dev-dependencies]
criterion = { workspace = true }

[[bin]]
name = "speed"

[features]
default = []
use_mdbx = []
# use_rocksdb disabled: rocksdb conflicts with cfx-kvdb-rocksdb via links="rocksdb"
use_rocksdb = []
use_nomt = ["dep:nomt", "dep:nomt-core"]
# use_lvmt disabled in Reth mode (zstd-sys conflict). Switch back via switch_backend.sh lvmt.
use_lvmt = []
use_reth = [
    "dep:reth-db", "dep:reth-db-api",
    "dep:reth-trie", "dep:reth-trie-common", "dep:reth-trie-db", "dep:reth-trie-parallel",
    "dep:reth-provider", "dep:reth-primitives", "dep:reth-node-types",
    "dep:alloy-primitives",
]
qmdb_bench_correctness = []
